{
	"format_version": "1.20.60",
	"minecraft:block": {
	  "description": {
		"identifier": "bap:soul_soil_slab",
		"menu_category": {
		  "category": "construction",
		  "group": "itemGroup.name.slab"
		},
		"traits": {
		  "minecraft:placement_position": {
			"enabled_states": ["minecraft:vertical_half"]
		  }
		}
	  },
	  "permutations": [
		{
		  "condition": "q.block_state('minecraft:vertical_half') == 'bottom'",
		  "components": {
			"minecraft:collision_box": {
			  "origin": [-8, 0, -8],
			  "size": [16, 8, 16]
			},
			"minecraft:selection_box": {
			  "origin": [-8, 0, -8],
			  "size": [16, 8, 16]
			}
		  }
		},
		{
		  "condition": "q.block_state('minecraft:vertical_half') == 'top'",
		  "components": {
			"minecraft:collision_box": {
			  "origin": [-8, 8, -8],
			  "size": [16, 8, 16]
			},
			"minecraft:selection_box": {
			  "origin": [-8, 8, -8],
			  "size": [16, 8, 16]
			}
		  }
		}
	  ],
	  "components": {
		"minecraft:destructible_by_mining": {
		  "seconds_to_destroy": 0.2
		},
		"minecraft:destructible_by_explosion": false,
		"minecraft:geometry": {
		  "identifier": "geometry.custom_slab",
		  "bone_visibility": {
			"bottom_slab": "q.block_state('minecraft:vertical_half') == 'bottom'",
			"top_slab": "q.block_state('minecraft:vertical_half') == 'top'"
		  }
		},
		"minecraft:material_instances": {
		  "*": {
			"texture": "soul_soil_slab"
		  }
		}
	  }
	}
  }
  